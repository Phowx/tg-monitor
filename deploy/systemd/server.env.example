# Install as /etc/tg-monitor/server.env, owned by root:root with mode 0600.
TG_MONITOR_DATABASE_PATH=/var/lib/tg-monitor/monitor.db
TG_MONITOR_LISTEN_ADDR=127.0.0.1:8080
TG_MONITOR_CHECKPOINT_INTERVAL=15s

# Optional Telegram administrator access. Keep disabled until every value below is set,
# then remove the leading "# " from those values and set the enable flag to true.
# Offline/alert thresholds and retention are persisted in SQLite and edited in the WebApp;
# do not add environment variables for them.
TG_MONITOR_TELEGRAM_ENABLED=false
# TG_MONITOR_PUBLIC_URL=https://monitor.example.com
# TG_MONITOR_BOT_TOKEN=replace-with-botfather-token
# TG_MONITOR_WEBHOOK_SECRET=replace-with-random-secret
# TG_MONITOR_ADMIN_TELEGRAM_IDS=replace-with-numeric-user-id
# TG_MONITOR_SESSION_TTL=12h
# TG_MONITOR_INIT_DATA_MAX_AGE=5m
# TG_MONITOR_TELEGRAM_HTTP_TIMEOUT=10s
